01 Appointment Measures =
Row("Column", BLANK())

// Table: 02 Time Intelligence
02 Time Intelligence =
Row("Column", BLANK())

// Table: 03 Operational Measures
03 Operational Measures =
Row("Column", BLANK())

// Table: 04 Patient Measures
04 Patient Measures =
Row("Column", BLANK())

